# Server 
PORT=5000
NODE_ENV=development

# JWT Authentication
# Generate a strong secret: openssl rand -hex 64
JWT_SECRET=change-this-to-a-long-random-secret

# Admin
ADMIN_EMAIL=admin@qsecuremail.local

# Key Management Simulator
KM_POOL_SIZE=1000
KM_REPLENISH_RATE=0

# CORS
CORS_ORIGIN=http://localhost:5173

# TLS Certificate Validation (set true in production with valid root CA certificates)
IMAP_REJECT_UNAUTHORIZED=false
